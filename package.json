{
  "name": "frappe-script-editor",
  "displayName": "Frappe Script Editor",
  "description": "Edit JavaScript, Python, HTML, and CSS scripts from Frappe Builder doctypes directly in VS Code with live sync on save.",
  "version": "0.1.0",
  "publisher": "frappe",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "frappe-builder",
          "title": "Frappe Builder",
          "icon": "$(terminal)"
        }
      ]
    },
    "views": {
      "frappe-builder": [
        {
          "type": "webview",
          "id": "frappe-builder-sites",
          "name": "Sites"
        },
        {
          "id": "frappe-builder-scripts",
          "name": "Scripts"
        }
      ]
    },
    "commands": [
      {
        "command": "frappeBuilder.addSite",
        "title": "Frappe Builder: Add Site",
        "icon": "$(add)"
      },
      {
        "command": "frappeBuilder.removeSite",
        "title": "Remove Site",
        "icon": "$(trash)"
      },
      {
        "command": "frappeBuilder.reloadSite",
        "title": "Reload Site Status",
        "icon": "$(refresh)"
      },
      {
        "command": "frappeBuilder.refreshScripts",
        "title": "Refresh Scripts",
        "icon": "$(refresh)"
      },
      {
        "command": "frappeBuilder.openScript",
        "title": "Open Script"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "frappeBuilder.refreshScripts",
          "when": "view == frappe-builder-scripts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "frappeBuilder.removeSite",
          "when": "view == frappe-builder-scripts && viewItem == site",
          "group": "inline"
        },
        {
          "command": "frappeBuilder.reloadSite",
          "when": "view == frappe-builder-scripts && viewItem == site"
        }
      ]
    },
    "configuration": {
      "title": "Frappe Script Editor",
      "properties": {
        "frappeBuilder.httpServerPort": {
          "type": "number",
          "default": 52698,
          "description": "Port for the local HTTP server that listens for browser requests."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  }
}
