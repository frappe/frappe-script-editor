{
  "name": "frappe-script-editor",
  "displayName": "Frappe Script Editor",
  "description": "Edit JavaScript, Python, HTML, and CSS scripts of Frappe doctypes directly in VS Code with sync on save.",
  "version": "1.5.0",
  "publisher": "PratikBadhe",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "icon": "images/frappe-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/frappe/frappe-script-editor"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "frappe-script-editor",
          "title": "Frappe Script Editor",
          "icon": "/images/frappe-icon.svg"
        }
      ]
    },
    "views": {
      "frappe-script-editor": [
        {
          "id": "frappe-script-editor",
          "name": "Sites"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "frappe-script-editor",
        "contents": "No sites configured. Add a site to get started.\n[Add Site](command:frappe-script-editor.addSite)",
        "when": "frappe-script-editor.hasSites == false"
      }
    ],
    "commands": [
      {
        "command": "frappe-script-editor.addSite",
        "title": "Frappe Script Editor: Add Site",
        "shortTitle": "Add Site",
        "icon": "$(add)"
      },
      {
        "command": "frappe-script-editor.removeSite",
        "title": "Frappe Script Editor: Remove Site",
        "shortTitle": "Remove Site",
        "icon": "$(trash)"
      },
      {
        "command": "frappe-script-editor.reloadSite",
        "title": "Frappe Script Editor: Reload Site Status",
        "shortTitle": "Reload Site Status",
        "icon": "$(refresh)"
      },
      {
        "command": "frappe-script-editor.refreshScripts",
        "title": "Frappe Script Editor: Refresh Scripts",
        "shortTitle": "Refresh Scripts",
        "icon": "$(refresh)"
      },
      {
        "command": "frappe-script-editor.collapseFolders",
        "title": "Frappe Script Editor: Collapse Folders",
        "shortTitle": "Collapse Folders",
        "icon": "$(collapse-all)"
      },
      {
        "command": "frappe-script-editor.openSite",
        "title": "Frappe Script Editor: Open Site",
        "shortTitle": "Open Site"
      },
      {
        "command": "frappe-script-editor.goBack",
        "title": "Frappe Script Editor: Go Back",
        "shortTitle": "Go Back",
        "icon": "$(arrow-left)"
      },
      {
        "command": "frappe-script-editor.searchBlocks",
        "title": "Frappe Script Editor: Search Blocks",
        "shortTitle": "Search",
        "icon": "$(search)"
      },
      {
        "command": "frappe-script-editor.clearSearch",
        "title": "Frappe Script Editor: Clear Search",
        "shortTitle": "Clear Search",
        "icon": "$(clear-all)"
      },
      {
        "command": "frappe-script-editor.managePagesVisibility",
        "title": "Frappe Script Editor: Manage Pages Visibility",
        "shortTitle": "Manage Pages",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "frappe-script-editor.goBack",
          "when": "view == frappe-script-editor && frappe-script-editor.isInSiteView",
          "group": "navigation@1"
        },
        {
          "command": "frappe-script-editor.addSite",
          "when": "view == frappe-script-editor && !frappe-script-editor.isInSiteView",
          "group": "navigation@2"
        },
        {
          "command": "frappe-script-editor.managePagesVisibility",
          "when": "view == frappe-script-editor && frappe-script-editor.isInSiteView",
          "group": "navigation@2"
        },
        {
          "command": "frappe-script-editor.refreshScripts",
          "when": "view == frappe-script-editor && frappe-script-editor.isInSiteView",
          "group": "navigation@3"
        },
        {
          "command": "frappe-script-editor.collapseFolders",
          "when": "view == frappe-script-editor && frappe-script-editor.isInSiteView",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "frappe-script-editor.removeSite",
          "when": "view == frappe-script-editor && viewItem == site",
          "group": "inline"
        },
        {
          "command": "frappe-script-editor.reloadSite",
          "when": "view == frappe-script-editor && viewItem == site",
          "group": "inline"
        },
        {
          "command": "frappe-script-editor.clearSearch",
          "when": "view == frappe-script-editor && viewItem == searchNodeActive",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "Frappe Script Editor",
      "properties": {}
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn compile",
    "compile": "esbuild ./src/extension.ts --bundle --outfile=./out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=./out/extension.js --external:vscode --format=cjs --platform=node --watch",
    "lint": "eslint src --ext ts",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "portfinder": "^1.0.38",
    "socket.io-client": "^4.8.3"
  }
}
