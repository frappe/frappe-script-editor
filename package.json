{
  "name": "frappe-script-editor",
  "displayName": "Frappe Script Editor",
  "description": "Edit JavaScript, Python, HTML, and CSS scripts from Frappe doctypes directly in VS Code with live sync on save.",
  "version": "0.1.0",
  "publisher": "frappe",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/frappe/frappe-script-editor"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "frappe-script-editor",
          "title": "Frappe Script Editor",
          "icon": "/images/frappe-icon.svg"
        }
      ]
    },
    "views": {
      "frappe-script-editor": [
        {
          "type": "webview",
          "id": "frappe-script-editor-sites",
          "name": "Sites"
        },
        {
          "id": "frappe-script-editor-scripts",
          "name": "Scripts"
        }
      ]
    },
    "commands": [
      {
        "command": "frappeScriptEditor.addSite",
        "title": "Frappe Script Editor: Add Site",
        "icon": "$(add)"
      },
      {
        "command": "frappeScriptEditor.removeSite",
        "title": "Remove Site",
        "icon": "$(trash)"
      },
      {
        "command": "frappeScriptEditor.reloadSite",
        "title": "Reload Site Status",
        "icon": "$(refresh)"
      },
      {
        "command": "frappeScriptEditor.refreshScripts",
        "title": "Refresh Scripts",
        "icon": "$(refresh)"
      },
      {
        "command": "frappeScriptEditor.collapseFolders",
        "title": "Collapse Folders",
        "icon": "$(collapse-all)"
      },
      {
        "command": "frappeScriptEditor.openScript",
        "title": "Open Script"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "frappeScriptEditor.refreshScripts",
          "when": "view == frappe-script-editor-scripts",
          "group": "navigation"
        },
        {
          "command": "frappeScriptEditor.collapseFolders",
          "when": "view == frappe-script-editor-scripts",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "frappeScriptEditor.removeSite",
          "when": "view == frappe-script-editor-scripts && viewItem == site",
          "group": "inline"
        },
        {
          "command": "frappeScriptEditor.reloadSite",
          "when": "view == frappe-script-editor-scripts && viewItem == site"
        }
      ]
    },
    "configuration": {
      "title": "Frappe Script Editor",
      "properties": {}
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "portfinder": "^1.0.38"
  }
}
