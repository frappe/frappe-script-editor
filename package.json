{
  "name": "frappe-script-editor",
  "displayName": "Frappe Script Editor",
  "description": "Edit JavaScript, Python, HTML, and CSS scripts from Frappe doctypes directly in VS Code with live sync on save.",
  "version": "0.1.0",
  "publisher": "frappe",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/frappe/frappe-script-editor"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "frappe-script-editor",
          "title": "Frappe Script Editor",
          "icon": "/images/frappe-icon.svg"
        }
      ]
    },
    "views": {
      "frappe-script-editor": [
        {
          "id": "frappe-script-editor-scripts",
          "name": "Sites"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "frappe-script-editor-scripts",
        "contents": "No sites configured. Add a site to get started.\n[Add Site](command:frappeScriptEditor.addSite)",
        "when": "frappeScriptEditor.hasSites == false"
      }
    ],
    "commands": [
      {
        "command": "frappeScriptEditor.addSite",
        "title": "Frappe Script Editor: Add Site",
        "shortTitle": "Add Site",
        "icon": "$(add)"
      },
      {
        "command": "frappeScriptEditor.removeSite",
        "title": "Frappe Script Editor: Remove Site",
        "shortTitle": "Remove Site",
        "icon": "$(trash)"
      },
      {
        "command": "frappeScriptEditor.reloadSite",
        "title": "Frappe Script Editor: Reload Site Status",
        "shortTitle": "Reload Site Status",
        "icon": "$(refresh)"
      },
      {
        "command": "frappeScriptEditor.refreshScripts",
        "title": "Frappe Script Editor: Refresh Scripts",
        "shortTitle": "Refresh Scripts",
        "icon": "$(refresh)"
      },
      {
        "command": "frappeScriptEditor.collapseFolders",
        "title": "Frappe Script Editor: Collapse Folders",
        "shortTitle": "Collapse Folders",
        "icon": "$(collapse-all)"
      },
      {
        "command": "frappeScriptEditor.openScript",
        "title": "Frappe Script Editor: Open Script",
        "shortTitle": "Open Script"

      },
      {
        "command": "frappeScriptEditor.openSite",
        "title": "Frappe Script Editor: Open Site",
        "shortTitle": "Open Site"
      },
      {
        "command": "frappeScriptEditor.goBack",
        "title": "Frappe Script Editor: Go Back",
        "shortTitle": "Go Back",
        "icon": "$(arrow-left)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "frappeScriptEditor.goBack",
          "when": "view == frappe-script-editor-scripts && frappeScriptEditor.currentSiteId",
          "group": "navigation@1"
        },
        {
          "command": "frappeScriptEditor.addSite",
          "when": "view == frappe-script-editor-scripts && !frappeScriptEditor.currentSiteId",
          "group": "navigation@2"
        },
        {
          "command": "frappeScriptEditor.refreshScripts",
          "when": "view == frappe-script-editor-scripts && frappeScriptEditor.currentSiteId",
          "group": "navigation@3"
        },
        {
          "command": "frappeScriptEditor.collapseFolders",
          "when": "view == frappe-script-editor-scripts && frappeScriptEditor.currentSiteId",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "frappeScriptEditor.removeSite",
          "when": "view == frappe-script-editor-scripts && viewItem == site",
          "group": "inline"
        },
        {
          "command": "frappeScriptEditor.reloadSite",
          "when": "view == frappe-script-editor-scripts && viewItem == site"
        }
      ]
    },
    "configuration": {
      "title": "Frappe Script Editor",
      "properties": {}
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "portfinder": "^1.0.38"
  }
}
